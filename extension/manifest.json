{
  "manifest_version": 3,
  "name": "HWA Helper",
  "version": "0.11.339",
  "description": "Personal page tweaks and API profiling for Hero Wars: Alliance",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.hero-wars-alliance.com/*",
    "https://hero-wars-alliance.com/*",
    "https://*.nextersglobal.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HWA Helper API log",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hero-wars-alliance.com/*",
        "https://hero-wars-alliance.com/*"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_start"
    }
  ]
}
