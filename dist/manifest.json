{
  "manifest_version": 3,
  "name": "HWA Helper",
  "version": "0.9.51",
  "description": "Personal page tweaks and API profiling for Hero Wars: Alliance",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.hero-wars-alliance.com/*",
    "https://hero-wars-alliance.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HWA Helper API log",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hero-wars-alliance.com/*",
        "https://hero-wars-alliance.com/*"
      ],
      "css": [
        "page.css"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.hero-wars-alliance.com/*",
        "https://hero-wars-alliance.com/*"
      ],
      "js": [
        "tracking-filter.js",
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
