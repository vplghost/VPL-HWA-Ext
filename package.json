{
  "name": "hwa-helper",
  "version": "0.9.231",
  "private": true,
  "description": "Personal Chrome extension for Hero Wars: Alliance",
  "scripts": {
    "assets:convert": "node scripts/convert-img-asset.mjs",
    "assets:sync": "node scripts/sync-cdn-assets.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --test tests/*.test.mjs && npm run build",
    "docs:data": "node scripts/generate-data-docs.mjs",
    "heroes:metadata": "node scripts/generate-hero-metadata.mjs",
    "items:assets": "node scripts/generate-item-assets.mjs",
    "names:update": "node scripts/generate-name-map.mjs",
    "tower:buffs": "node scripts/generate-tower-buffs.mjs",
    "building:metadata": "node scripts/generate-building-data.mjs",
    "rules:production": "node scripts/generate-production-rules.mjs",
    "titans:metadata": "node scripts/generate-titan-metadata.mjs",
    "quests:update": "node scripts/generate-quest-data.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tex-decoder": "^2.0.0"
  }
}
