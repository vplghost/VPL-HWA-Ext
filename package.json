    "rules:production": "node scripts/generate-production-rules.mjs",
    "titans:metadata": "node scripts/generate-titan-metadata.mjs",
    "quests:update": "node scripts/generate-quest-data.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "wxt:build": "wxt build",
    "wxt:dev": "wxt"
